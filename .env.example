# Copy this file to .env (or run `npm run setup` to create .env interactively).

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Used to sign admin sessions. Must be at least 16 characters.
# `npm run setup` generates a random one for you.
SESSION_SECRET=replace-me-with-a-long-random-string

# Default site name (can be changed later in /admin/settings)
SITE_NAME="Enchanted Wiki"
